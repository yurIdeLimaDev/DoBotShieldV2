# Backend protected by DoBot Shield. Do not point this URL back to the WAF.
TARGET_URL=http://host.docker.internal:4280

# Host port exposed by Docker Compose.
WAF_PORT=8080

# Supported values: block, monitor, off.
WAF_MODE=block

# Accept forwarded client metadata only from explicitly trusted peers.
TRUSTED_PROXIES=127.0.0.1,::1
